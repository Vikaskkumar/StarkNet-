{
  "name": "social-media-app",
  "version": "1.0.0",
  "description": "Full-stack Social Media App with modular Frontend & Backend",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix Backend run dev",
    "dev:frontend": "npm --prefix Frontend run dev",
    "start": "npm --prefix Backend start",
    "build": "npm --prefix Frontend ci && npm --prefix Frontend run build",
    "install:all": "npm --prefix Backend install && npm --prefix Frontend install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
