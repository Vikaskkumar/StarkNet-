{
  "installCommand": "npm install && npm --prefix Backend install && npm --prefix Frontend install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(signup|signin|createPost|allposts|myposts|myprofile|like|unlike|comment|deletepost|user|follow|unfollow|myfollowingpost|uploadProfilePic|removeProfilePic|health)(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
